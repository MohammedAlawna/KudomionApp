<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:local="clr-namespace:KudomionApp.MVVM.ViewModels.Popups"
    xmlns:controls="clr-namespace:Microsoft.Maui.Controls;assembly=Microsoft.Maui.Controls"
    x:Class="KudomionApp.MVVM.Views.Popups.SelectUserPopup"
    x:Name="PopupRoot"
    >

    <Border StrokeThickness="2" Stroke="Black" Padding="10" BackgroundColor="#2e2e2e">
        <VerticalStackLayout Spacing="10">
            <Label Text="Select a user to chat with:"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="White" />

            <Picker x:Name="UserPicker"
                    Title="Choose a user"
                    TextColor="Black"
                   
                    BackgroundColor="White" />

            <Button Text="Start Chat"
                    Clicked="OnStartChatClicked"
                    BackgroundColor="RoyalBlue"
                    TextColor="White" />
        </VerticalStackLayout>
    </Border>

</toolkit:Popup>
